{ #category : #'gt - extensions' }
BrMaterial2014Colors class >> gtColorsFor: aView [
	<gtView>
	<gtClassView>
	^ aView columnedList
		title: 'Colors';
		priority: 0.5;
		items: [ (self class selectors
				select: [ :each | 
					each numArgs isZero
						and: [ (self class >> each) protocolName beginsWith: 'colors -' ] ])
				sorted ];
		column: 'Color'
			textDo: [ :column | 
				column
					item: [ :selector | 
						| color |
						color := self perform: selector.
						(selector asString, ' #', color asHexString) asRopedText
							foreground: color contrastingBlackAndWhiteColor;
							yourself ];
					background: [ :cellValue :selector | self perform: selector ] ];
		contextItemLabel: 'Browse method'
			action: [ :anElement :selector | 
				anElement phlow
					spawnTool: (GtMethodCoderTool compiledMethod: self class >> selector) ];
		send: [ :selector | self perform: selector ]
]

